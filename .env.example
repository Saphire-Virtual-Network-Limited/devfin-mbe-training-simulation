# Copy to .env.local for local development. In Vercel, set these as
# environment variables (mark the secrets as Sensitive). Never commit real values.

# Random value of at least 32 characters, used to sign session cookies.
# Generate one with: openssl rand -base64 48
# Changing it signs everyone out.
SESSION_SECRET=

# Neon Postgres (add the Neon integration in Vercel; it fills this in).
# Then run once: npm run migrate
DATABASE_URL=

# Staff codes allowed into the trainer view, comma-separated, e.g. MBE-E8CABF,MBE-12AB34
TRAINER_STAFF_CODES=

# Always-available test login. Its attempts are tagged "demo" and left out of
# trainer reports unless a trainer chooses to include them.
DEMO_LOGIN_ENABLED=true
DEMO_LOGIN_USERNAME=demo
# Output of: npm run hash-password
DEMO_LOGIN_PASSWORD_HASH=
# "mbe" (default) or "trainer" to let testers also open the trainer view.
DEMO_LOGIN_ROLE=trainer
