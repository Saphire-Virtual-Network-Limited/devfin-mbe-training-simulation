# Copy to .env.local for local development. In Vercel, set these as
# environment variables (mark the secrets as Sensitive). Never commit real values.

# Random value of at least 32 characters, used to sign session cookies.
# Generate one with: openssl rand -base64 48
# Changing it signs everyone out.
SESSION_SECRET=

# Neon Postgres (add the Neon integration in Vercel; it fills this in).
# Then run once: npm run migrate
DATABASE_URL=

# MBE codes that get the trainer view, comma-separated, e.g. MBE-E8CABF,MBE-12AB34.
# They must also be on the MBE list (npm run import-mbes, or added by another trainer).
TRAINER_CODES=
# Trainers enter this passcode on top of code + phone. Output of: npm run hash-password
TRAINER_PASSCODE_HASH=

# Always-available test login: a code and phone that aren't a real MBE.
# Practice only (never trainer). Its scores are tagged "demo" and left out of
# trainer reports unless a trainer chooses to include them.
DEMO_LOGIN_ENABLED=true
DEMO_MBE_CODE=DEMO-0001
DEMO_MBE_PHONE=08000000001
